"         else if (plan->out == TEXD_OUT16)\n"
"         {\n"
"            unsigned short s = (unsigned short)v;\n"
"            memcpy((unsigned char *)dst + at * 2, &s, 2);\n"
"         }\n"
"         else\n"
"            ((unsigned char *)dst)[at] = (unsigned char)v;\n"
"      }\n"
"}\n"
