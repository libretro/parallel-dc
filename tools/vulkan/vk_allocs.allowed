# Where the core still allocates during play with Vulkan, by function
# (tools/vulkan/vk_allocs.sh, vk_alloc_sites.py; "heap" or "vulkan" for
# Vulkan memory, buffers, images and pools). AGENTS.md, "No allocations
# during play": this list only ever shrinks. A commit that removes a site
# takes it off; docs/AllocationPlan.md says how each group goes.

# The SH-4 dynarec, compiling a block the game runs for the first time
heap ngen_Compile
heap BlockCompiler::compile
heap BlockCompiler::GenGoOn
heap BlockCompiler::GenSliceCheck
heap BlockCompiler::CheckBlock
heap ngen_CC_Param
heap ngen_AllocateBlock
heap ngen_link
heap Emit
heap bm_AddBlock
heap RuntimeBlockInfo::hash

# Video memory watched for writes (the texture cache's locks; renders to
# textures, their copies' room grown when one is watched, never in the
# signal handler that reads them back)
heap vramlock_list_add
heap libCore_vramlock_Lock
heap rtt_watch_add
heap vk_rtt_watch

# The texture cache: a texture first seen, and its pictures
heap BaseVulkanRenderer::GetTexture
heap BaseTextureCacheData::HashPieces
heap TexturePool::Make
vulkan TexturePool::Make
heap StringFromFormatV        # (TexturePool::Make's log line)
heap SamplerManager::GetSampler

# Renders to textures: their targets and buffers
heap TextureDrawer::BeginRenderPass
vulkan BufferData::BufferData
vulkan FramebufferAttachment::Init
heap OITTextureDrawer::TakeTexture
heap OITTextureDrawer::NewFrame

# A frame's draws: descriptor sets, the quad's, the sort's buffers
heap QuadDrawer::Draw
heap DescriptorSets::SetTexture
heap DescriptorSets::UpdateUniforms
heap Drawer::SortIntoMainBuffer
heap SortPasses
heap SortPParams
heap GenSortedTo
heap OITDescriptorSets::SetTexture
heap OITDescriptorSets::UpdateColorInputDescSet
heap OITDescriptorSets::UpdateUniforms
heap OITDrawer::GetMainBuffer
heap OITDrawer::MakeBuffers
heap vk_heap_block_insert
